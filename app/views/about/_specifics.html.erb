<% if (Loss.exists?(slug: 'alsc')) %>
  <h4 id="alsc"><a href="<%= url_for('losses/alsc') %>" class="link">Association for Library Service to Children</a></h4>
  <p>
  <%= raw(formula_html("conferences")) %>
  There were 300 confirmed attendees for this event (via email from <a href="http://www.ala.org/alsc/" class="link" target="_blank">ALA</a> source).
  <%= raw(hotel_html("Charlotte")) %>
  </p>
<% end %>

<% if (Loss.exists?(slug: 'ani-difranco')) %>
  <h4 id="ani-difranco"><a href="<%= url_for('losses/ani-difranco') %>" class="link">Ani DiFranco</a></h4>
  <p>
  This event (<a href="http://www.enoriver.org/festival/" class="link" target="_blank">The 37th Annual Festival for the Eno</a>) was not actually cancelled. Ani DiFranco was however the planned headliner for the event until she pulled out. Based on <a href="http://www.enoriver.org/festival/applications/Eno_Demographics.pdf" class="link" target="_blank">this document of Eno Festival demographics</a>, we have a total economic impact for the festival at $1.9 million (also note that this is from 2010). We've estimated that the festival lost 2% of the total attendees over the lost headlining artist. We took 2% of $1.9 million, or $38,000.
  </p>
<% end %>

<% if (Loss.exists?(slug: 'blue-man-group')) %>
  <h4 id="blue-man-group"><a href="<%= url_for('losses/blue-man-group') %>" class="link">Blue Man Group</a></h4>
  <p><%= raw(formula_html("performances")) %> There were 7 total shows planned to take place at Charlotte's Belk Theater, which has a capacity of 2,097. The average ticket price for a Blue Man Group show is <a href="http://www.pollstar.com/atpDetail.aspx?SearchBy=B" class="link" target="_blank">$58.23</a>. <%= raw(hotel_html("Charlotte")) %>
  </p>
<% end %>

<% if (Loss.exists?(slug: 'boston')) %>
  <h4 id="boston"><a href="<%= url_for('losses/boston') %>" class="link">Boston</a></h4>
  <p>
    <%= raw(formula_html("performances")) %>
    Three shows were cancelled, one at Charlotte's Spectrum Center (formerly Time Warner Cable Arena, capacity 16,700), another at Greensboro's White Oak Amphitheatre (capacity 7,061), and the last at Raleigh's Red Hat Ampitheater (capacity 5,990).
    <%= raw(average_ticket_price(58.73, "Boston", "http://www.pollstar.com/atpDetail.aspx?SearchBy=B")) %>
    <%= raw(hotel_html("Raleigh")) %>
    <%= raw(hotel_html("Charlotte")) %>
    <%= raw(hotel_html("Greensboro")) %>
  </p>
<% end %>

<% if (Loss.exists?(slug: 'cirque-du-soleil')) %>
  <h4 id="cirque-du-soleil"><a href="<%= url_for('losses/cirque-du-soleil') %>" class="link">Cirque du Soleil</a></h4>
