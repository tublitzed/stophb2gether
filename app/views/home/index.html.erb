<% if logged_in? %>
  <div class="row">
    <div class="col-sm-12">
      <p class="lead">In March 2016, the state of North Carolina signed <a href="#">House Bill 2</a>(HB2) into law. We've been <a href="#">losing money</a> ever since. The question is: how long are we going to let this continue?</p>
      <h1 class="lead"><%= number_to_currency(@totalLosses) %></h1>
      <h2 class="lead">lost so far</h2>
      <hr>
    </div>
  </div>

  <% @allLosses.each do |loss| %>
  <div class="row">
    <div class="col-sm-12">
      <%= loss.title %>
    </div>
  </div>
  <% end %>
<% end %>
