<% provide(:title, 'Chronicling the HB2 related economic losses to the state of North Carolina.') %>

<div class="row">
  <div class="large-6 large-centered columns">
    <div class="banner-text">
      <h1 class="banner-text__title">
      $<%= number_to_currency(@totalLosses, precision: 0, unit: '') %>
      </h1>
      <h2 class="banner-text__subtitle">lost to HB2</h2>
    </div>
  </div>
</div>

<div class="row">
  <div class="small-12 columns">
    <p class="lead">On March 23rd, 2016, the state of North Carolina signed <a href="<%= url_for('resources') %>" class="link">HB2</a> into law. We've been <a href="<%= url_for('losses') %>" class="link">losing money</a> ever since. The question now is: how long are we going to let this continue?</p>
  </div>
</div>

<div class="row">
  <div class="small-12 columns">
    <div class="chart-wrapper">
      <canvas class="chart" data-chart-type="losses-over-time"></canvas>
    </div>
  </div>
</div>

<div class="row">
  <div class="small-12 columns">
    <%= render partial: 'partials/losses', locals: { losses: @allLosses } %>
    <%= render partial: 'partials/linkToAll' %>
  </div>
</div>
