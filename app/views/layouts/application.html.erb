<%= render partial: 'partials/head' %>
<body class="<% if @appPath.present? %>body--<%= @appPath %><% end %>">
  <%= render partial: 'partials/flash', locals: {flash: flash} %>
  <%= render partial: 'partials/header' %>

<% if !logged_in? && @appPath == 'home' %>
  <div class="home-banner"></div>
  <div class="fader fader--home"></div>
<% end %>

<div class="app-container">
  <div class="container">
    <%= yield %>
  </div>
</div>
<%= render partial: 'partials/footer' %>
<%= render partial: 'partials/foot' %>
</body>
</html>
