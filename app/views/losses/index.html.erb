<% provide(:title, "Losses | So far, North Carolina has lost over #{number_to_currency(@totalLosses, precision: 0)} to HB2.") %>

<%= render partial: 'partials/pageTitle', locals: { title: 'Losses', desc: "So far, North Carolina has lost over #{number_to_currency(@totalLosses, precision: 0)} to HB2." } %>

<div class="row">
  <div class="small-12 columns">
    <ul class="tabs" data-tabs id="losses-page-tabs">
      <li class="tabs-title<% if  @active_tab == 'losses' %> is-active<% end %>" data-tab-name="losses"><a href="#panel-losses" aria-selected="true">Losses</a></li>
      <li class="tabs-title<% if  @active_tab == 'other' %> is-active<% end %>" data-tab-name="other"><a href="#panel-other">Items not included</a></li>
    </ul>
  </div>
</div>

<div class="row">
  <div class="small-12 columns">
    <div class="tabs-content" data-tabs-content="losses-page-tabs">
      <div class="tabs-panel<% if  @active_tab == 'losses' %> is-active<% end %>"" id="panel-losses">

        <%= render partial: 'partials/pagination', locals: { currentPage: @currentPage, perPage: @perPage, items: @allLosses } %>
        <hr />
        <%= render partial: 'partials/losses', locals: { losses: @allLosses } %>

      <br />
      <small class="small">Is this list missing something? <a href="<%= contact_path %>" class="link">Let us know.</a></small>
      </div>
      <div class="tabs-panel<% if  @active_tab == 'other' %> is-active<% end %>"" id="panel-other">
          <%= render partial: 'lossesNotIncluded' %>
      </div>
    </div>
  </div>
</div>
