<% provide(:title, @loss.title.html_safe) %>

<div class="row">
  <div class="small-12 columns">
    <p class="lead">
     <%= @loss.title %>
    </p>
    <hr class="sm-only">
    <h1 class="lead"><%= number_to_currency(@loss.amount, precision: 0) %></span></h1>
    <h2 class="lead">lost</h2>
    <hr>
    <h3 class="section-heading"><%= @loss.date.strftime("%B %d, %Y") %></h3>
    <div class="template">
      <%= @loss.template.html_safe %>
    </div>

    <% if @loss.sources %>
      <hr>
      <h3 class="section-heading">Sources:</h3>
      <ul class="source-list">
        <% @loss.sources.each do |source| %>
          <li>
            <% if source['link'] == 'CUSTOM_CALC' %>
              <a href="/about/calculations">Custom calculation</a>
            <% else %>
              <%= source['meta']['author'] %>, <%= source['meta']['date'] %>.
              "<a href="<%= source['link'] %>" class="link" target="_blank"><%= source['meta']['title'] %></a>",
              <%= source['meta']['publication'] %>.
              <span class="subtle">Accessed on <%= source['meta']['accessed'] %>.</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <hr />
  </div>
</div>
<%= render partial: 'partials/linkToAll' %>
