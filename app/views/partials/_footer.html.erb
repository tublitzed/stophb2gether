<footer class="footer">
  <ul class="footer__links footer__links--legal">
    <li>
      &copy; <a href="https://tublitzed.com" target="_blank">Tublitzed LLC</a>, <%= Date.current.year %>.
    </li>
  </ul>
  <ul class="footer__links">
    <% if logged_in? %>
      <li>
        <a href="<%= about_path %>">
          About
        </a>
      </li>
      <li>
        <a href="<%= contact_path %>">Contact Us</a>
      </li>
      <li>
        <%= link_to 'Logout', logout_path, method: 'delete' %>
      </li>
    <% else %>
      <li><%= link_to 'Login', login_path %></li>
    <% end %>
  </ul>
</footer>
