<nav class="nav">
  <ul class="nav__links">
    <% if logged_in? %>
      <li>
        <a href="<%= about_path %>" class="nav__link<% if @appPath == 'about' %> nav__link--active<% end %>">
          About
        </a>
      </li>
      <li>
        <a href="<%= losses_path %>" class="nav__link<% if @appPath == 'losses' %> nav__link--active<% end %>">
          Losses
        </a>
      </li>
    <% else %>
      <li><%= link_to 'Login', login_path, class: 'nav__link' %></li>
    <% end %>
  </ul>
</nav>
