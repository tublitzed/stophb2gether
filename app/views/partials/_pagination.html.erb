<%
  itemCount = items.size
  pageCount = (itemCount/perPage.to_f).ceil
  rangeStart = (perPage * current_page) - (perPage - 1)
  rangeEnd = (rangeStart + perPage) - 1

  if rangeEnd > itemCount
    rangeEnd = itemCount
  end
%>

<div class="pagination-info">
  Viewing <%= rangeStart %>-<%= rangeEnd %> of <%= itemCount %>.
</div>
<ul class="pagination" role="navigation" aria-label="Pagination">

  <li class="pagination-previous<% if current_page <= 1 %> disabled<% end %>">
    <% if current_page <= 1 %>
      Previous <span class="show-for-sr">page</span>
    <% else %>
      <a href="<%= url_for(controller: 'losses', action: 'index', tab: 'losses', page: current_page - 1) %>" aria-label="Previous page">Previous <span class="show-for-sr">page</span></a>
    <% end %>
  </li>

  <% (1..pageCount).each do |page| %>
    <li class="item<% if page == current_page %> current<% end %>">
      <% if page == current_page %>
        <span class="show-for-sr">You're on page</span>
      <% end %>
      <a href="<%= url_for(controller: 'losses', action: 'index', tab: 'losses', page: page) %>" aria-label="Page <%= page %>"><%= page %></a>
    </li>
  <% end %>

  <li class="pagination-next<% if current_page >= pageCount %> disabled<% end %>">
    <% if current_page >= pageCount %>
      Next <span class="show-for-sr">page</span>
    <% else %>
      <a href="<%= url_for(controller: 'losses', action: 'index', tab: 'losses', page: current_page + 1) %>" aria-label="Next page">Next <span class="show-for-sr">page</span></a>
    <% end %>
  </li>

</ul>
