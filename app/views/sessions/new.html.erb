<% provide(:title, "Login") %>
<div class="row">
  <div class="col-4"></div>
  <div class="col-4">
      <h1 class="title">Login</h1>
      <%= form_for(:session, url: login_path, html: {class: 'form'}) do |f| %>

        <%= f.label :email, class: 'form__label' %>
        <%= f.email_field :email, class: 'form__text-input autofocus' %>
        <br />
        <%= f.label :password, class: 'form__label' %>
        <%= f.password_field :password, class: 'form__text-input' %>
        <br />

        <%= f.label :remember_me, class: 'form__field-wrapper' do %>
          <%= f.check_box :remember_me, class: 'form__checkbox' %>
          <span>Remember me</span>
        <% end %>

        <button type="submit" class="btn btn--primary">Login</button>
      <% end %>
  </div>
  <div class="col-4"></div>
</div>
