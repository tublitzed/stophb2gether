<% provide(:title, 'Sign up') %>
<%= render partial: 'partials/pageTitle', locals: { title: 'Sign up', desc: nil } %>
<br />
<br />
<div class="row">
  <div class="small-12 columns">
  <%= form_for @user, url: {action: 'create'}, html: {class: 'form'} do |f| %>
    <%= render partial: 'shared/form_errors', locals: {errors: @user.errors} %>
    <%= f.label :name, class: 'form__label' %>
    <%= f.text_field :name, class: 'form__text-input' %>
    <br />
    <%= f.label :email, class: 'form__label' %>
    <%= f.email_field :email, class: 'form__text-input' %>
    <br />
    <%= f.label :password, class: 'form__label' %>
    <%= f.password_field :password, class: 'form__text-input' %>
    <br />
    <%= f.label :password_confirmation, "Password Confirmation", class: 'form__label' %>
    <%= f.password_field :password_confirmation, class: 'form__text-input' %>
    <br />
    <button type="submit" class="btn btn--primary">Create my account</button>
  <% end %>
  </div>
</div>
