{
  "name": "stophb2gether",
  "description": "Anti hb2 site dedicate to tracking lost revenue to the state of NC since HB2.",
  "repository": "https://github.com/tublitzed/stophb2gether.git",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "babel-eslint": "^6.0.2",
    "babel-preset-es2015": "^6.1.18",
    "babelify": "^7.2.0",
    "browserify": "~> 10.2.4",
    "browserify-incremental": "^3.0.1",
    "eslint": "^2.7.0",
    "nodemon": "^1.9.1"
  },
  "engines": {
    "node": ">= 0.10"
  },
  "scripts": {
    "lint": "eslint ./app/assets/javascripts/src",
    "build": "browserify ./app/assets/javascripts/src/main.js -o ./app/assets/javascripts/dist/main.bundle.js",
    "w": "nodemon -e js -w ./app/assets/javascripts/src -x 'npm run build'"
  },
  "browserify": {
    "transform": [
      "babelify"
    ]
  },
  "dependencies": {
    "bootstrap": "^4.0.0-alpha.3"
  }
}
